8Li(d,3He)7He @ 45 AMeV Haixia OMP (d) + HT1p OMP (3He) and Ex = 17 MeV
NAMELIST
 &FRESCO  hcm=0.05 rmatch=25.000 rintp=0.50
     hnl=0.200 rnl=5.00 centre=0.90
     jtmin=0.0 jtmax=40.0 absend=-0.1
     thmin=0.00 thmax=180.00 thinc=1.0 
     iter= 1 
     chans=1 listcc=0 treneg=0 cdetr=0 smats=2 xstabl=1
     elab(1)=90 / ! Beam energy is for deuteron: 45 AMeV * 2

! Incoming partition : d + 8Li
 &PARTITION namep='d' massp=2.013553 zp=1 nex=1 namet='8Li' masst=8.02084 zt=3 qval=0/
 &STATES jp=1 bandp=1 ep=0.0  cpot=1 jt=2.0 bandt=1 et=0.0000/

! Outgoing partition: 3He + 7He
 &PARTITION namep='3He' massp=3.01493 zp=2 nex=1 namet='7He' masst=7.02689 zt=2 qval=-6.9227/ ! qvalue is for g.s. transition
 &STATES jp=0.5 bandp=1 ep=0.0000  cpot=2 jt=1.5 bandt=+1 et=17.0000/
 ! FAKE 7He state at 17 MeV 3/2+ so that coupling to 0s1/2 proton yields 2+ for 8Li g.s.
 &partition /

! Incoming partition optical model potential (OMP), d @ 90 MeV
! Haixia An et al. PRC 73 (2006)
&pot kp=1 type=0 p(1:3)= 8.0000  0.0000  1.3030 /
&pot kp=1 type=1 p(1:6)= 71.3345  1.1481  0.7442  6.7020  1.3548  0.6550 /
&pot kp=1 type=2 p(1:6)= 0.0000  0.0000  0.0000  8.0760  1.4100  0.6550 /
&pot kp=1 type=3 p(1:6)= 1.7785  0.9720  1.0110  0.0000  0.0000  0.0000 /

! Outgoing partition OMP, p @ 68.35 MeV (to yield same ECM in inverse reaction, bearing in mind Ex)
! D. Y. Pang et al. PRC 91 (2015)
&pot kp=2 type=0 p(1:3)= 7.0000  0.0000  1.3000 /
&pot kp=2 type=1 p(1:6)= 110.6432  1.0827  0.7920  4.9944  1.3464  0.8010 /
&pot kp=2 type=2 p(1:6)= 0.0000  0.0000  0.0000  11.4872  1.3464  0.8010 /

! Light-particle overlap
! From GFMC results. See Table VIII in I. Brida et al. PRC 84 (2011)
 &pot kp= 3 type= 0 p(1:3)=1.00  0.0000  2.00 /
 &pot kp= 3 type= 1 p(1:3)=179.94  0.54  0.6800 /
 &pot kp= 3 type= 1 shape=2 p(1:3)=-203.33  0.00  0.64 /

! Heavy-particle overlap
! Woods-Saxon potential with r0 = 1.25 fm, a = 0.65 fm and Vreal adjusted to BE
! Spin-orbit fixed
 &pot kp=4 type=0 p(1:3)=7.00  0.0000  1.2500 /
 &pot kp=4 type=1 p(1:3)=60.000  1.2500  0.6500 /
 &pot kp=4 type=3 p(1:3)=6.000  1.1000  0.6500 /
 &pot /   ! END OF DEFINING POTENTIALS

! Particle overlaps
! Light one
 &OVERLAP kn1=1 kn2=0 ic1=1 ic2=2 in=-1 kind=0 nn=1 l=0 sn=0.5 j=0.5 kbpot=3 krpot=0 be=5.4936 isc=1 ipc=4 nfl=0 nam=1 ampl=1.0 /
 ! Heavy one: here you put the nlj of the transferred nucleon 0s1/2 -> nn = 1; l = 0; j = 1/2; spin (s) = 1/2
 ! be = binding energy of the transferred proton in compound nucleus: depends on Ex: BE_eff = BE0 + Ex... assuming Ex = 17 for now
 &OVERLAP kn1=2 kn2=0 ic1=1 ic2=2 in=-2 kind=0 nn=1 l=0 sn=0.5 j=0.5 kbpot=4 krpot=0 be=29.4163 isc=1 ipc=4 nfl=0 nam=1 ampl=1.0 /
 &overlap /   ! END OF DEFINING OVERLAPS

! Couple partitions through overlaps
! kind = 7 -> finite-range transfer
 &COUPLING icto=2 icfrom=1 kind=7 ip1=1 ip2=0 ip3= 0 /
   &cfp  in=1 ib=1 ia=1 kn=1  a=1.1446  / ! spec. amplitude from I. Brida et al.
   &cfp  in=-2 ib=1 ia=1 kn=2  a=1.000   / ! spec. amplitude to be determined experimentally
 &COUPLING /
