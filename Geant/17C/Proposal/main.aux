\newlabel{tab:sm}{{1}{4}{Predicted states in \iso {18}{C} populated through the \iso {17}{C}(d,p) reaction using the WBT interaction \cite {warburton1992}. Only $\ctwos \geq \qty {0.05}{}$ are listed.\relax }{table.caption.2}{}}
