\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Left:} neutron ESPEs for the $1s_{1/2}$ and $0d_{3/2}$ orbitals in carbon isotopes, predicted by the SFO-tls interaction (solid lines) and compared with the experimental results (points), extracted from \blx@tocontentsinit {0}\cite {lois-fuentes2025}. \textbf  {Right:} Calculated $B(M1)$ rates for different transitions in \ce {^{17}C} \blx@tocontentsinit {0}\cite {smalley2015} within the NCSM without three-nucleon forces (left column), with three-nucleon forces (second-to-left), and with an NCSM adjusted to reproduce the correct binding energies (second-to-right), compared with the experimental results (right). The phenomenological NCSM provides the best reproduction of the experimental data.\relax }}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:exp_17c}{{1}{1}{\textbf {Left:} neutron ESPEs for the $1s_{1/2}$ and $0d_{3/2}$ orbitals in carbon isotopes, predicted by the SFO-tls interaction (solid lines) and compared with the experimental results (points), extracted from \cite {lois-fuentes2025}. \textbf {Right:} Calculated $B(M1)$ rates for different transitions in \iso {17}{C} \cite {smalley2015} within the NCSM without three-nucleon forces (left column), with three-nucleon forces (second-to-left), and with an NCSM adjusted to reproduce the correct binding energies (second-to-right), compared with the experimental results (right). The phenomenological NCSM provides the best reproduction of the experimental data.\relax }{figure.caption.1}{}}
