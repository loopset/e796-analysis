\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Scheme of the experimental setup. The secondary \ce {^{17}C} beam impinges on ACTAR TPC, where the reactions take place. Emitted light particles are then measured in the TPC using the \textit  {L1} trigger (see text below) and in three Si detector walls. Finally, the ZDD is used to detect the heavy recoil in coincidence. The optimum distances and gas settings are also shown.\relax }}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:setup}{{3}{5}{Scheme of the experimental setup. The secondary \iso {17}{C} beam impinges on ACTAR TPC, where the reactions take place. Emitted light particles are then measured in the TPC using the \textit {L1} trigger (see text below) and in three Si detector walls. Finally, the ZDD is used to detect the heavy recoil in coincidence. The optimum distances and gas settings are also shown.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {0.3}Beam production}{5}{subsection.0.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {0.4}Light-particle detection with ACTAR TPC}{5}{subsection.0.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Left}: simulated laboratory kinematic lines of the \ce {^{17}C}(d,p)\ce {^{18}C} reaction to different excited states of \ce {^{18}C}. The shaded grey band indicates the region to which the \textit  {L1} trigger contributes. \textbf  {Right}: Reconstructed \ensuremath  {E_{\text  {x}}}\xspace  peaks, with one- and two-neutron thresholds indicated. The inset shows the experimental resolution evolution for each simulated state in \ce {^{18}C}, with an average of $\sigma = \qty {250}{\keV }$.\relax }}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:simu_kin_ex}{{4}{6}{\textbf {Left}: simulated laboratory kinematic lines of the \iso {17}{C}(d,p)\iso {18}{C} reaction to different excited states of \iso {18}{C}. The shaded grey band indicates the region to which the \textit {L1} trigger contributes. \textbf {Right}: Reconstructed \ex peaks, with one- and two-neutron thresholds indicated. The inset shows the experimental resolution evolution for each simulated state in \iso {18}{C}, with an average of $\sigma = \qty {250}{\keV }$.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Left:} efficiency as a function of centre-of-mass angle for representative states in \ce {^{18}C}. The shaded grey band indicates the contribution of the internal multiplicity trigger. \textbf  {Right:} theoretical angular distributions obtained for $l = 0, 1\, \text  {and}\, 2$ transfer using TWOFNR.\relax }}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:eff_theoxs}{{5}{6}{\textbf {Left:} efficiency as a function of centre-of-mass angle for representative states in \iso {18}{C}. The shaded grey band indicates the contribution of the internal multiplicity trigger. \textbf {Right:} theoretical angular distributions obtained for $l = 0, 1\, \text {and}\, 2$ transfer using TWOFNR.\relax }{figure.caption.6}{}}
